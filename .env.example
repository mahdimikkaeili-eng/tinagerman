# ============================================================
# Deutsch mit Tina - Environment Variables
# tinagerman.com
# ============================================================
# کپی این فایل به .env و مقادیر را تکمیل کنید
# Copy this file to .env and fill in the values
# ============================================================

# === دیتابیس - Database ===
# مسیر فایل SQLite - SQLite database file path
DATABASE_URL=file:./db/custom.db

# === محیط Node - Node Environment ===
NODE_ENV=production

# === آدرس سایت - Site URL ===
NEXT_PUBLIC_SITE_URL=https://tinagerman.com

# === پورت چت سرویس - Chat Service Port ===
CHAT_PORT=3003

# === احراز هویت - Authentication ===
# راز برای رمزنگاری توکن - Secret for token encryption
# یک رشته تصادفی طولانی تولید کنید: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-secret

# === تنظیمات اختیاری - Optional Settings ===
# پورت سرور Next.js (پیش‌فرض: 3000)
# Next.js server port (default: 3000)
# PORT=3000

# آدرس هاست (پیش‌فرض: 0.0.0.0 برای دسترسی از بیرون)
# Host address (default: 0.0.0.0 for external access)
# HOSTNAME=0.0.0.0
