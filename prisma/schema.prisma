generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  password     String
  role         String   @default("student") // "student" | "teacher" | "admin"
  phone        String?
  telegramChatId String? // Telegram chat ID for notifications
  nativeLanguage String? // "en", "de", "fa", etc.
  germanLevel  String? // "A1", "A2", "B1", "B2"
  bio          String?
  avatar       String?
  timezone     String? @default("Europe/Vienna")
  isTrialUsed  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings     Booking[]
  sentMessages Message[]  @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  homeworks    Homework[] @relation("StudentHomework")
  assignedHomeworks Homework[] @relation("TeacherHomework")
  testimonials Testimonial[]
  notifications Notification[]
}

model Course {
  id          String   @id @default(cuid())
  title       String
  titleDe     String   // German title
  description String
  descriptionDe String // German description
  level       String   // "A1", "A2", "B1", "B2"
  duration    Int      // minutes per session
  priceNote   String   @default("Price discussed in first session")
  language    String   @default("de") // taught language
  category    String?  // "grammar", "conversation", "exam-prep", "business"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings    Booking[]
}

model Booking {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  date        String   // ISO date string
  time        String   // HH:mm format
  status      String   @default("pending") // "pending", "confirmed", "completed", "cancelled"
  isTrial     Boolean  @default(false)
  meetLink    String?  // Google Meet link
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  course      Course   @relation(fields: [courseId], references: [id])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model Homework {
  id                 String   @id @default(cuid())
  teacherId          String
  studentId          String
  title              String
  description        String
  dueDate            String?  // ISO date string
  status             String   @default("assigned") // "assigned", "submitted", "reviewed"
  feedback           String?
  attachment         String?  // Teacher's attachment URL
  studentAttachment  String?  // Student's submission attachment URL
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  teacher     User     @relation("TeacherHomework", fields: [teacherId], references: [id])
  student     User     @relation("StudentHomework", fields: [studentId], references: [id])
}

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  userId    String
  rating    Int      @default(5)
  comment   String
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  title      String
  message    String
  type       String   @default("info") // "reminder", "booking", "info", "approval"
  isRead     Boolean  @default(false)
  actionUrl  String?  // e.g. WhatsApp link, booking page
  bookingId  String?  // related booking
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
}
